NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/glowtrack
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d
CORS_ORIGIN=http://localhost:8081
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX=5
LOG_LEVEL=info

# AI Coach / OpenRouter Configuration
AI_MODEL=google/gemma-4-31b-it:free
AI_FALLBACK_MODELS=google/gemma-4-26b-a4b-it:free,poolside/laguna-xs-2.1:free
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
